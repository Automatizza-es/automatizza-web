{
  "name": "automatizza-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-node-runtime.mjs && next dev",
    "dev:tag-assistant": "node scripts/check-node-runtime.mjs && node scripts/dev-tag-assistant.mjs",
    "build": "node scripts/check-node-runtime.mjs && next build --webpack",
    "start": "node scripts/check-node-runtime.mjs && next start",
    "lint": "eslint .",
    "test:contact": "node scripts/test-contact.mjs",
    "test:analytics": "node scripts/test-analytics.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:structured-data": "node scripts/test-structured-data.mjs",
    "test:security": "node scripts/test-security.mjs",
    "check:runtime": "node scripts/check-node-runtime.mjs",
    "test:runtime": "node --test tests/node-runtime.test.mjs",
    "blog": "node scripts/check-node-runtime.mjs && node scripts/blog.mjs",
    "test:blog": "node --test tests/blog.test.mjs",
    "test:blog:publication": "node scripts/check-node-runtime.mjs && node scripts/test-blog-publication.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
