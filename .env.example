# Private server variables. Never prefix these with NEXT_PUBLIC_.
# Keep disabled until the policy in src/content/privacy.ts is completed/reviewed.
CONTACT_FORM_ENABLED=false
# Explicit local-only test sends with fictitious data. Ignored in production/Vercel.
CONTACT_FORM_TEST_MODE=false
RESEND_API_KEY=
# Optional separate key with permission to retrieve the domain; otherwise uses RESEND_API_KEY.
RESEND_VERIFY_API_KEY=
RESEND_DOMAIN_ID=
# Bare address in the exact domain verified by Resend. No unverified fallback sender.
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=info@automatizza.es
# Comma-separated exact origins. Required in production; no wildcard.
CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Only set true when a trusted reverse proxy overwrites X-Forwarded-For and
# direct public access to the application is blocked. Vercel is detected automatically.
CONTACT_TRUST_PROXY=false
